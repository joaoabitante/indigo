# Gera um cabeçalho C++ com arquivos binários embutidos (fontes da interface): indigo_embed(saida.h nome arquivo ...)
# Cada arquivo vira "inline constexpr unsigned char <nome><n>[]" (n = 0, 1, ...) com o tamanho em <nome><n>_size.
function(indigo_embed out name)
  set(body "// gerado pelo CMake (cmake/embed.cmake): não editar\n#pragma once\n#include <cstddef>\n")
  set(i 0)
  foreach(f ${ARGN})
    file(READ "${f}" hex HEX)
    string(LENGTH "${hex}" len)
    math(EXPR size "${len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," arr "${hex}")
    string(APPEND body "inline constexpr unsigned char ${name}${i}[] = {${arr}};\ninline constexpr std::size_t ${name}${i}_size = ${size};\n")
    math(EXPR i "${i} + 1")
  endforeach()
  file(WRITE "${out}.tmp" "${body}")
  file(COPY_FILE "${out}.tmp" "${out}" ONLY_IF_DIFFERENT)
endfunction()
