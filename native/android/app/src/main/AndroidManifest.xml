<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <uses-feature android:glEsVersion="0x00020000" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- frontends que mandam o caminho do arquivo (file://) em vez de content:// (Android 12 ou anterior) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_regras"
        android:dataExtractionRules="@xml/backup_regras_12"
        android:theme="@style/AppTheme"
        android:enableOnBackInvokedCallback="false"
        android:hardwareAccelerated="true">

        <meta-data android:name="SDL_ENV.SDL_ANDROID_TRAP_BACK_BUTTON" android:value="1" />

        <activity android:name=".IndigoActivity"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- aparece também nos lançadores de TV e de portáteis (Android TV, Anbernic, Retroid, AYN) -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- sem BROWSABLE: página da internet não abre o Índigo direto (o "Abrir com" e os downloads só
                 precisam de DEFAULT) -->
            <!-- abrir um jogo vindo do "Abrir com". Os frontends (ES-DE, Daijisho, Beacon) chamam a atividade pelo
                 nome e não dependem desta lista. Só tipos de jogo (ROM, .zip, imagem de CD e arquivo sem tipo
                 conhecido): com "*/*" o Índigo aparecia até para abrir APK, e quem marcava "Sempre" não conseguia
                 mais instalar uma versão nova -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-iso9660-image" />
                <data android:mimeType="application/x-cd-image" />
                <data android:mimeType="application/x-cue" />
                <data android:mimeType="text/x-cue" />
                <data android:mimeType="application/x-gameboy-rom" />
                <data android:mimeType="application/x-gameboy-color-rom" />
                <data android:mimeType="application/x-gba-rom" />
                <data android:mimeType="application/x-nes-rom" />
                <data android:mimeType="application/x-snes-rom" />
                <data android:mimeType="application/x-genesis-rom" />
                <data android:mimeType="application/x-sms-rom" />
                <data android:mimeType="application/x-gamegear-rom" />
                <data android:mimeType="application/x-pc-engine-rom" />
                <data android:mimeType="application/x-virtual-boy-rom" />
                <data android:mimeType="application/x-neo-geo-pocket-rom" />
                <data android:mimeType="application/x-neo-geo-pocket-color-rom" />
                <data android:mimeType="application/x-wonderswan-rom" />
                <data android:mimeType="application/x-wonderswan-color-rom" />
                <data android:mimeType="application/x-atari-2600-rom" />
                <data android:mimeType="application/x-atari-7800-rom" />
                <data android:mimeType="application/x-atari-lynx-rom" />
                <data android:mimeType="application/x-sg1000-rom" />
                <data android:mimeType="application/x-msx-rom" />
                <data android:mimeType="application/x-pokemon-mini-rom" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </activity>
    </application>
</manifest>
